# Salin ke .env untuk pengembangan lokal dengan Turso (JANGAN commit .env!).
# Tanpa kedua variabel ini, aplikasi memakai SQLite lokal seperti biasa.
# Isi dari: turso db show <nama-db> --url  dan  turso db tokens create <nama-db>
TURSO_DATABASE_URL=libsql://ship-agency-xxxx.turso.io
TURSO_AUTH_TOKEN=
